<Page x:Class="SmokingCessationSupportPlatform.Admin.BadgeManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BadgeManagementPage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Quản lý huy hiệu" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" />

            <Button Content="➕ Tạo huy hiệu mới" Width="200" Margin="0 0 0 20" Click="Button_Click" />

            <DataGrid x:Name="dgBadge" AutoGenerateColumns="False" CanUserAddRows="False" Height="163">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Badge Id" Binding="{Binding BadgeId}" Width="100"/>
                    <DataGridTextColumn Header="Badge Name" Binding="{Binding BadgeName}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Criteria" Binding="{Binding Criteria}" Width="160"/>
                    <DataGridTextColumn Header="Badge Type" Binding="{Binding BadgeType}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal">
                <Label Content="Enter Badge ID to Search" />
                <TextBox x:Name="txtSearch" Width="200" Height="30"/>
                <Button x:Name="btnSearch" Content="Search" Height="30" Width="60" Click="btnSearch_Click" />
                <Button x:Name="btnClear" Content="Clear" Height="30" Width="60" Click="btnClear_Click"  />
            </StackPanel>
            <StackPanel x:Name="spInputForm" Visibility="Collapsed" >
                <StackPanel Orientation="Horizontal">
                <Label Content="Badge Name" Width="80" />
                <TextBox x:Name="txtBadgeName" Width="200" Height="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="description" Width="80" />
                <TextBox x:Name="txtDescription" Width="200" Height="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Criteria" Width="80"/>
                <TextBox x:Name="txtCriteria" Width="200" Height="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Badge Type" Width="80"/>
                <TextBox x:Name="txtBadgeType" Width="200" Height="30"/>
                <Button x:Name="btnCreate" Content="Create" Width="60" Height="30" Background="Green" Click="btnCreate_Click"/>
            </StackPanel>
        </StackPanel>
            </StackPanel>
    </Grid>
</Page>
