<Page x:Class="SmokingCessationSupportPlatform.Admin.PostManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PostManagementPage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Quản lý Bài viết" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

            <DataGrid x:Name="PostsDataGrid" AutoGenerateColumns="False" Height="450">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PostId}" Width="60"/>
                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="250"/>
                    <DataGridTextColumn Header="Người đăng" Binding="{Binding AuthorName}" Width="200"/>
                    <DataGridTextColumn Header="Ngày đăng" Binding="{Binding CreatedAt}" Width="120"/>
                    <DataGridTemplateColumn Header="Hành động" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xem"  Tag="{Binding PostId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
