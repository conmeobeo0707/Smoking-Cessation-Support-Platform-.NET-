<Page x:Class="SmokingCessationSupportPlatform.Admin.MemberPackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MemberPackagePage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Quản lý gói thành viên" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" />

            <Button Content="➕ Tạo gói mới" Width="200" Margin="0 0 0 20" />

            <DataGrid x:Name="MemberPackagesDataGrid" AutoGenerateColumns="False" Height="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PackageId}" Width="50"/>
                    <DataGridTextColumn Header="Tên gói" Binding="{Binding PackageName}" Width="200"/>
                    <DataGridTextColumn Header="Giá" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="Thời hạn (ngày)" Binding="{Binding DurationDays}" Width="150"/>
                    <DataGridTemplateColumn Header="Hành động" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xem"  Tag="{Binding PackageId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
