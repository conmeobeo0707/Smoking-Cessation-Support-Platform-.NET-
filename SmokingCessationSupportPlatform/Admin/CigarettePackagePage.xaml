<Page x:Class="SmokingCessationSupportPlatform.Admin.CigarettePackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CigarettePackagePage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Quản lý Gói thuốc" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" />

            <Button Content="➕ Tạo gói thuốc mới" Width="200" Margin="0 0 0 20" />

            <DataGrid x:Name="CigarettePackagesDataGrid" AutoGenerateColumns="False" Height="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PackageId}" Width="60"/>
                    <DataGridTextColumn Header="Tên gói" Binding="{Binding PackageName}" Width="200"/>
                    <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="300"/>
                    <DataGridTextColumn Header="Giá tiền" Binding="{Binding Price}" Width="100"/>
                    <DataGridTemplateColumn Header="Hành động" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" Margin="5,0" Tag="{Binding PackageId}"/>
                                    <Button Content="🗑️" Margin="5,0" Tag="{Binding PackageId}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
