<Page x:Class="SmokingCessationSupportPlatform.Admin.NotificationManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NotificationManagementPage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Gửi Thông báo" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Tiêu đề:" FontWeight="Bold"/>
                <TextBox x:Name="TitleTextBox" Height="30"/>
            </StackPanel>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Nội dung:" FontWeight="Bold"/>
                <TextBox x:Name="ContentTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <Button Content="📤 Gửi thông báo" Width="200" />
        </StackPanel>
    </Grid>
</Page>
