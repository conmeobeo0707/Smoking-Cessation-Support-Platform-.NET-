<Window x:Class="SmokingCessationSupportPlatform.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F5E9" Offset="0"/>
            <GradientStop Color="#A5D6A7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Border Width="450" Height="358" Background="White" CornerRadius="15" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Đăng nhập" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0 0 0 20"/>

                <StackPanel Margin="0 10">
                    <Label Content="Email" Foreground="#2E7D32"/>
                    <TextBox x:Name="txtEmail" Height="35" FontSize="16" />
                </StackPanel>

                <StackPanel Margin="0 10">
                    <Label Content="Mật khẩu" Foreground="#2E7D32"/>
                    <PasswordBox x:Name="txtPassword" Height="35" FontSize="16"/>
                </StackPanel>

                <Button Content="Đăng nhập" Height="40" Margin="0 20 0 0"
                        Background="#388E3C" Foreground="White" FontSize="16" FontWeight="Bold"
                        Click="btnButton_Click" Width="296" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
