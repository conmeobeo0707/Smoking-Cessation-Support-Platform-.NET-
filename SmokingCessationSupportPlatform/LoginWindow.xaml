<Window x:Class="SmokingCessationSupportPlatform.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">

    <Window.Resources >
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="#FF2E7D32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="23"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#FF388E3C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Canvas>
            <Label Content="Email" Width="64" Canvas.Left="240" Canvas.Top="146"/>
            <TextBox x:Name="txtEmail" Width="200" Canvas.Left="316" Canvas.Top="156" Height="30" >
            </TextBox>
            <Label Content="Password" Canvas.Left="198" Canvas.Top="184"/>
            <PasswordBox x:Name="txtPassword" Width="200" Canvas.Left="317" Canvas.Top="191" Height="30">

            </PasswordBox>
            <Button x:Name="btnButton" Content="Login" Canvas.Left="320" Canvas.Top="224" Width="200" Height="47" Click="btnButton_Click" />
        </Canvas>
    </Grid>

</Window>
