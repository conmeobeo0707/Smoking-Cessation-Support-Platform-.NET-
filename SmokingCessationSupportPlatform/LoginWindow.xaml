<Window x:Class="SmokingCessationSupportPlatform.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
        mc:Ignorable="d"
        Title="LoginWindow" Height="700" Width="1200">

    <Window.Resources >
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="#FF2E7D32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="23"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#FF388E3C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Canvas>
            <Label Content="Email" Width="64" Canvas.Left="431" Canvas.Top="268" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="txtEmail" Width="200" Canvas.Left="500" Canvas.Top="272" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" >
            </TextBox>
            <Label Content="Password" Canvas.Left="389" Canvas.Top="304" RenderTransformOrigin="1.767,3.973" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Width="200" Canvas.Left="500" Canvas.Top="307" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">

            </PasswordBox>
            <Button x:Name="btnButton" Content="Login" Canvas.Left="500" Canvas.Top="342" Width="200" Height="47" Click="btnButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Canvas>
    </Grid>

</Window>
