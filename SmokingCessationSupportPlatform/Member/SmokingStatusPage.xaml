<Page x:Class="SmokingCessationSupportPlatform.Member.SmokingStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SmokingStatusPage"
      Background="White">

    <Grid Width="506" Height="543">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="400">
            <TextBlock Text="🚬 Cập nhật trạng thái hút thuốc" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" />

            <Label Content="Chọn trạng thái" FontWeight="Bold"/>
            <ComboBox x:Name="cbStatus" Height="35" Margin="0 10">
                <ComboBoxItem Content="Đang hút thuốc" />
                <ComboBoxItem Content="Cai thuốc" />
                <ComboBoxItem Content="Đã bỏ thuốc" />
            </ComboBox>

            <Label Content="Ngày cập nhật" FontWeight="Bold"/>
            <DatePicker x:Name="dpDate" Margin="0 10" />

            <StackPanel Orientation="Horizontal" Margin="0 20" HorizontalAlignment="Center">
                <Button Content="Tạo mới" Click="Create_Click" Width="100" Margin="5"/>
                <Button Content="Cập nhật" Click="Update_Click" Width="100" Margin="5" Background="#F57C00"/>
            </StackPanel>

            <!-- 🔽 Lịch sử hiển thị tại đây -->
            <StackPanel Margin="0 30 0 0">
                <TextBlock Text="🕘 Lịch sử trạng thái" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                <ListBox x:Name="HistoryListBox" Height="150" BorderBrush="Gray" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅 " FontSize="16"/>
                                <TextBlock Text="{Binding DateDisplay}" FontSize="16"/>
                                <TextBlock Text=" - " FontSize="16"/>
                                <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
