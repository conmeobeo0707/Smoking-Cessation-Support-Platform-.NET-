<Page x:Class="SmokingCessationSupportPlatform.Member.BadgePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BadgePage">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="My Badges" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <ListView x:Name="lvBadges" Height="300" SelectionChanged="lvBadges_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding BadgeName}" Width="150"/>
                        <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                        <GridViewColumn Header="Achieved Date" DisplayMemberBinding="{Binding AchievedDate}" Width="150"/>
                        <GridViewColumn Header="Shared" DisplayMemberBinding="{Binding Shared}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="View Details" Width="120" Margin="0,0,10,0" Click="BtnViewDetails_Click"/>
                <Button Content="Share Badge" Width="120" Click="BtnShareBadge_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
