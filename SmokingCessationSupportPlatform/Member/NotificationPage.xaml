<Page x:Class="SmokingCessationSupportPlatform.Member.NotificationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:SmokingCessationSupportPlatform.Helpers"
      Title="NotificationPage">

    <Page.Resources>
        <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8F9F9">
        <StackPanel Margin="20">
            <TextBlock Text="🔔 Thông báo của bạn" FontSize="26" FontWeight="Bold" Foreground="#2E86C1" Margin="0 0 0 20"/>

            <ItemsControl x:Name="NotificationList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 10" Padding="12"
                                Background="{Binding IsUnread, Converter={StaticResource BoolToColorConverter}}"
                                CornerRadius="6" BorderBrush="#D6DBDF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Content}" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                    <Border Background="#2980B9" CornerRadius="4" Padding="4,2" Margin="0 5 8 0">
                                        <TextBlock Text="{Binding NotificationType}" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding SendDate, StringFormat='Gửi lúc: {0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
