 <Page x:Class="SmokingCessationSupportPlatform.Member.PostManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SmokingCessationSupportPlatform.Member"
      Title="Quản lý bài viết">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="📝 Quản lý bài viết" FontSize="26" FontWeight="Bold" Foreground="#2E7D32" Margin="0 0 0 20"/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <Grid>
                    <TextBox x:Name="txtSearch" Width="250" Height="30" TextChanged="txtSearch_TextChanged"/>
                    <TextBlock x:Name="tbPlaceholder" Text="Nhập ID bài viết..."
                               Foreground="Gray" IsHitTestVisible="False"
                               Margin="5,3,0,0" VerticalAlignment="Top"
                               Visibility="Visible"/>
                </Grid>
                <Button Content="🔍 Tìm kiếm" Width="100" Margin="10 0 0 0" Click="btnSearch_Click"/>
                <Button Content="🔄 Tải lại" Width="100" Margin="10 0 0 0" Click="btnReload_Click"/>
                <Button Content="➕ Tạo mới" Width="100" Margin="10 0 0 0" Background="#4CAF50" Foreground="White" Click="btnCreate_Click"/>
            </StackPanel>

            <DataGrid x:Name="dgPosts" AutoGenerateColumns="False" Height="400" CanUserAddRows="False" Width="750">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PostId}" Width="60"/>
                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Tác giả" Binding="{Binding UserName}" Width="150"/>
                    <DataGridTextColumn Header="Ngày đăng" Binding="{Binding PostDate}" Width="180"/>
                    <DataGridTemplateColumn Header="Hành động" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁️" Width="30" Margin="2" Click="btnView_Click" Tag="{Binding PostId}"/>
                                    <Button Content="🗑️" Width="30" Margin="2" Click="btnDelete_Click" Tag="{Binding PostId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>