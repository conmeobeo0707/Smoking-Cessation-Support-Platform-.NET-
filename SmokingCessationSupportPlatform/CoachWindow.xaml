<Window x:Class="SmokingCessationSupportPlatform.CoachWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="CoachManagementPage" Height="700" Width="1200">

    <Grid Background="White">
        <StackPanel Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Title -->
            <TextBlock Text="Quản lý kế hoạch hỗ trợ" 
                       FontSize="26" FontWeight="Bold" Foreground="#2D2D30" Margin="0 0 0 20"/>

            <!-- DataGrid -->
            <DataGrid x:Name="dgQuitPlans"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Height="300"
                      Margin="0 0 0 10"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      RowBackground="White"
                      AlternatingRowBackground="#F9F9F9"
                      BorderBrush="#DDD"
                      BorderThickness="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" Width="80"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=d}" Width="150"/>
                <DataGridTextColumn Header="Expected End Date" Binding="{Binding ExpectedEndDate, StringFormat=d}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/>
                <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*"/>
                <DataGridTextColumn Header="Coach ID" Binding="{Binding CoachId}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tìm kiếm -->
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0" VerticalAlignment="Center">
                <Label Content="Enter User ID to Search:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtUserId" Width="200" Height="30" Margin="5 0"/>
                <Button Content="Search" Width="60" Height="30" Margin="5 0" Click="Button_Click"/>
                <Button Content="Clear" Width="80" Height="30" Margin="5 0" Click="Button_Click_1" />
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>