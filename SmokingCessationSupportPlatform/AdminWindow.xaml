<Window x:Class="SmokingCessationSupportPlatform.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmokingCessationSupportPlatform"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    <Grid>
        <!-- Sidebar -->
        <Grid Width="220" Background="#111827" VerticalAlignment="Stretch" HorizontalAlignment="Left">
            <StackPanel Margin="20 30" VerticalAlignment="Top" >
                <TextBlock Text="Admin Panel" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0 0 0 30"/>

                <Button Content="👥 Người dùng"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🏅 Huy hiệu"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🎁 Gói thành viên"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🚬 Gói thuốc"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="📝 Bài viết"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🔔 Thông báo"  Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Grid Margin="220,0,0,0" Height="60" VerticalAlignment="Top" Background="#1F2937">
            <TextBlock Text="Bảng điều khiển quản trị" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <!-- Main Content Area -->
        <Border Margin="220,60,0,0" Background="White" CornerRadius="10" Padding="20">
            <Frame x:Name="MainContent" NavigationUIVisibility="Hidden" />
        </Border>
    </Grid>
</Window>
