<Window x:Class="SmokingCessationSupportPlatform.Member.MemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Dashboard" Height="600" Width="1000">
    <Grid>
        <!-- Define Grid Layout with Sidebar + Header + MainContent -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Grid Grid.RowSpan="2" Background="#111827">
            <StackPanel Margin="20 30" VerticalAlignment="Top">
                <TextBlock Text="Member Panel" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0 0 0 30"/>
                <Button Content="👤 Profile" Click="Btn_Profile_Click" Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="📅 My Quit Plan" Click="Btn_QuitPlan_Click" Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🏅 My Badges" Click="Btn_Badge_Click" Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="📈 Progress" Click="Btn_Progress_Click" Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
                <Button Content="🔒 Logout" Click="Btn_Logout_Click" Margin="0 5" Padding="10" Foreground="White" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Grid Grid.Column="1" Background="#1F2937">
            <TextBlock Text="Member Dashboard" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="10">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        </Border>
    </Grid>
</Window>
