<Window x:Class="SmokingCessationSupportPlatform.Member.MemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Dashboard" Height="600" Width="1000">
    <Grid>
        <DockPanel>
            <!-- Sidebar Navigation -->
            <StackPanel DockPanel.Dock="Left" Width="200" Background="#333">
                <Button Content="👤 Profile" Click="Btn_Profile_Click" Margin="5" Foreground="DarkBlue"/>
                <Button Content="📅 My Quit Plan" Click="Btn_QuitPlan_Click" Margin="5" Foreground="DarkBlue"/>
                <Button Content="🏅 My Badges" Click="Btn_Badge_Click" Margin="5" Foreground="DarkBlue"/>
                <Button Content="📈 Progress" Click="Btn_Progress_Click" Margin="5" Foreground="DarkBlue"/>
                <Button Content="🔒 Logout" Click="Btn_Logout_Click" Margin="5" Foreground="DarkBlue"/>
            </StackPanel>

            <!-- Main Frame -->
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        </DockPanel>
    </Grid>
</Window>
