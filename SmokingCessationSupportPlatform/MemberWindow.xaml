<Window x:Class="SmokingCessationSupportPlatform.Member.MemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Dashboard" Height="700" Width="1200">
    <Window.Resources>
        <!-- Brush dùng chung cho Header và Sidebar -->
        <LinearGradientBrush x:Key="HeaderSidebarBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F5E9" Offset="0"/>
            <GradientStop Color="#A5D6A7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- Layout Sidebar + Header + MainContent -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Grid Grid.RowSpan="2" Background="{StaticResource HeaderSidebarBackground}">
            <StackPanel Margin="20 30" VerticalAlignment="Top">
                <TextBlock Text="Member Panel" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" Margin="0 0 0 30"/>

                <Button Content="🏠 Dashboard" Click="Dashboard_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>

                <Button Content="📝 Bài viết" Click="Post_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>

                <Button Content="🏅 Huy hiệu" Click="Achievement_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>

                <Button Content="🔔 Thông báo" Click="Notification_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>

                <Button Content="🚬 Trạng thái hút thuốc" Click="SmokingStatus_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>

                <Button Content="📅 My Quit Plan" Click="Btn_QuitPlan_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>

                <Button Content="🏅 My Badges" Click="Btn_Badge_Click" Margin="0 5" Padding="10"
                        Foreground="#2C3E50" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>

                <Button Content="🔒 Logout" Click="Btn_Logout_Click" Margin="0 5" Padding="10"
                        Foreground="White" Background="Red" BorderBrush="Transparent" HorizontalContentAlignment="Left" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Grid Grid.Column="1" Background="{StaticResource HeaderSidebarBackground}">
            <TextBlock Text="Member Dashboard" Foreground="#2C3E50" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="10">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        </Border>
    </Grid>
</Window>
